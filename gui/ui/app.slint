import {
    AboutSlint,
    Button,
    ComboBox,
    Palette,
    ScrollView,
    VerticalBox,
    HorizontalBox,
    StandardButton,
    DatePickerPopup,
} from "std-widgets.slint";
import {
    LineItem,
    ActionType,
    Action,
    FileEntry,
    GraphAxis,
    GraphPoint,
    GraphPath,
} from "@components/structs.slint";
import { FileDialog } from "@components/file-dialog.slint";
import { LineCard } from "@components/line-card.slint";

export component GraphWindow inherits Window {
    title: "3D Graph View";
    min-width: 760px;
    min-height: 560px;
    preferred-width: 880px;
    preferred-height: 640px;

    in property <[GraphPoint]> graph-points;
    in property <[GraphPath]> graph-paths;
    in property <[GraphAxis]> graph-axes;
    in-out property <float> yaw-degrees: 32;
    in-out property <float> pitch-degrees: 22;
    in-out property <float> view-zoom: 1.0;
    in-out property <float> view-offset-x: 0;
    in-out property <float> view-offset-y: 0;
    callback rotationChanged(float, float);

    changed yaw-degrees => {
        root.rotationChanged(root.yaw-degrees, root.pitch-degrees);
    }

    changed pitch-degrees => {
        root.rotationChanged(root.yaw-degrees, root.pitch-degrees);
    }

    Rectangle {
        background: #f3f6fb;

        Rectangle {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            background: #ffffff;
            border-width: 1px;
            border-color: #d7dee8;
            border-radius: 12px;

            Text {
                x: 20px;
                y: 18px;
                text: "Projected 3D scatter: X = line index, Y = numeric field count, Z = numeric sum";
                color: #1f2937;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                x: 20px;
                y: 48px;
                text: "Drag the sphere controller to rotate yaw and pitch together.";
                color: #5b6472;
                font-size: 13px;
            }

            sphere-control := Rectangle {
                x: (parent.width - self.width) / 2;
                y: 70px;
                width: 132px;
                height: 132px;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: #9fb3cc;
                background: ta.has-hover ? #dce9f8 : #e6eef9;

                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: #c7d3e3;
                    background: #f6faff;
                }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: 1px;
                    height: parent.height - 16px;
                    background: #9fb3cc;
                }

                Rectangle {
                    x: 8px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 16px;
                    height: 1px;
                    background: #9fb3cc;
                }

                // Trackball handle derived from current yaw/pitch angles.
                handle := Rectangle {
                    private property <float> normalized-x: (Math.mod(root.yaw-degrees, 360) / 180) - 1;
                    private property <float> normalized-y: 1 - (Math.mod(root.pitch-degrees, 360) / 180);
                    width: 16px;
                    height: 16px;
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: #1e293b;
                    background: #ffffff;
                    x: (sphere-control.width / 2) + normalized-x * ((sphere-control.width / 2) - 14px) - (self.width / 2);
                    y: (sphere-control.height / 2) + normalized-y * ((sphere-control.height / 2) - 14px) - (self.height / 2);
                }

                Text {
                    x: -120px;
                    y: 8px;
                    width: 110px;
                    horizontal-alignment: right;
                    text: "Yaw " + Math.round(root.yaw-degrees) + "°";
                    color: #334155;
                    font-size: 12px;
                }

                Text {
                    x: parent.width + 10px;
                    y: 8px;
                    width: 110px;
                    text: "Pitch " + Math.round(root.pitch-degrees) + "°";
                    color: #334155;
                    font-size: 12px;
                }

                ta := TouchArea {
                    mouse-cursor: ta.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    moved => {
                        let cx = sphere-control.width / 2;
                        let cy = sphere-control.height / 2;
                        let dx = (ta.mouse-x - cx) / (sphere-control.width / 2);
                        let dy = (ta.mouse-y - cy) / (sphere-control.height / 2);
                        root.yaw-degrees = Math.mod(((dx + 1) * 180), 360);
                        root.pitch-degrees = Math.mod(((1 - dy) * 180), 360);
                    }
                }
            }

            plot-area := Rectangle {
                x: 20px;
                y: 214px;
                width: parent.width - 40px;
                height: parent.height - 234px;
                background: #fbfdff;
                border-width: 1px;
                border-color: #e5eaf1;
                border-radius: 10px;
                clip: true;

                for graph-axis in root.graph-axes: Path {
                    x: ((plot-area.width * (1 - root.view-zoom)) / 2) + root.view-offset-x * 1px;
                    y: ((plot-area.height * (1 - root.view-zoom)) / 2) + root.view-offset-y * 1px;
                    width: parent.width * root.view-zoom;
                    height: parent.height * root.view-zoom;
                    viewbox-width: plot-area.width / 1px;
                    viewbox-height: plot-area.height / 1px;
                    clip: true;
                    fill: transparent;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    opacity: 0.35 + (graph-axis.depth / 3) * 0.25;
                    stroke: graph-axis.axis == 0 ? #1d4ed8 : graph-axis.axis == 1 ? #b45309 : #047857;
                    commands: graph-axis.commands;
                }

                for graph-axis in root.graph-axes: Text {
                    x: (((graph-axis.label-x * 1px) - (plot-area.width / 2)) * root.view-zoom) + (plot-area.width / 2) + root.view-offset-x * 1px;
                    y: (((graph-axis.label-y * 1px) - (plot-area.height / 2)) * root.view-zoom) + (plot-area.height / 2) + root.view-offset-y * 1px;
                    text: graph-axis.label;
                    color: graph-axis.axis == 0 ? #1d4ed8 : graph-axis.axis == 1 ? #b45309 : #047857;
                    font-weight: 700;
                }

                for graph-path in root.graph-paths: Path {
                    x: ((plot-area.width * (1 - root.view-zoom)) / 2) + root.view-offset-x * 1px;
                    y: ((plot-area.height * (1 - root.view-zoom)) / 2) + root.view-offset-y * 1px;
                    width: parent.width * root.view-zoom;
                    height: parent.height * root.view-zoom;
                    viewbox-width: plot-area.width / 1px;
                    viewbox-height: plot-area.height / 1px;
                    clip: true;
                    fill: transparent;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    opacity: 0.2 + (graph-path.depth / 3) * 0.35;
                    stroke: Math.mod(graph-path.series, 5) == 0 ? #115e59 : Math.mod(graph-path.series, 5) == 1 ? #1d4ed8 : Math.mod(graph-path.series, 5) == 2 ? #9a3412 : Math.mod(graph-path.series, 5) == 3 ? #6d28d9 : #9f1239;
                    commands: graph-path.commands;
                }

                for point in root.graph-points: Rectangle {
                    width: point.size * 1px;
                    height: point.size * 1px;
                    x: (((point.x * 1px) - (plot-area.width / 2)) * root.view-zoom) + (plot-area.width / 2) + root.view-offset-x * 1px - (self.width / 2);
                    y: (((point.y * 1px) - (plot-area.height / 2)) * root.view-zoom) + (plot-area.height / 2) + root.view-offset-y * 1px - (self.height / 2);
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: #ffffff;
                    opacity: 0.45 + (point.depth / 3) * 0.55;
                    background: Math.mod(point.series, 5) == 0 ? #0f766e : Math.mod(point.series, 5) == 1 ? #2563eb : Math.mod(point.series, 5) == 2 ? #c2410c : Math.mod(point.series, 5) == 3 ? #7c3aed : #be123c;
                }

                if root.graph-points.length == 0: Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "No calculated points yet. Validate a line and wait for its calculation to finish.";
                    color: #64748b;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                navigation-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    private property <float> last-x: 0;
                    private property <float> last-y: 0;

                    changed pressed => {
                        if (self.pressed) {
                            self.last-x = self.mouse-x / 1px;
                            self.last-y = self.mouse-y / 1px;
                        }
                    }

                    moved => {
                        let current-x = self.mouse-x / 1px;
                        let current-y = self.mouse-y / 1px;
                        root.view-offset-x += current-x - self.last-x;
                        root.view-offset-y += current-y - self.last-y;
                        self.last-x = current-x;
                        self.last-y = current-y;
                    }

                    scroll-event(event) => {
                        if (event.delta-y > 0px) {
                            root.view-zoom = Math.min(4.0, root.view-zoom * 1.1);
                            return accept;
                        }
                        if (event.delta-y < 0px) {
                            root.view-zoom = Math.max(0.35, root.view-zoom * 0.9);
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
    }
}


export component AppWindow inherits Window {
    title: "Schema Elements Editor";
    min-width: 600px;
    min-height: 400px;
    preferred-width: 800px;
    preferred-height: 600px;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    in property <[string]> schema-names;
    in property <[string]> init-schema-names;
    in-out property <[LineItem]> lines;
    in property <[string]> list-names;
    in-out property <int> active-list-index: 0;
    in-out property <bool> is-dirty: false;
    in-out property <string> file-browser-dir;
    in-out property <[FileEntry]> file-browser-entries;
    in-out property <string> file-browser-file-name;
    // Focus-first-invalid support: epoch increments each validate, line/key-data hold the target
    in-out property <int> validate-epoch: 0;
    in-out property <int> first-invalid-line: -1;
    in-out property <int> first-invalid-key-data: -1;
    // Incremented by Rust to trigger the validation-error popup
    in-out property <int> validation-error-epoch: 0;
    // Set by Rust to true when pre-save validation passes, triggering the file dialog
    in-out property <bool> open-save-dialog: false;
    // Incremented by Rust to move keyboard focus from line editors back to toolbar controls.
    in-out property <int> focus-toolbar-epoch: 0;
    // Incremented by Rust to move keyboard focus to the Add List button.
    in-out property <int> focus-add-list-epoch: 0;

    // File dialog state
    private property <bool> file-dialog-is-save: true;

    callback dispatch(Action);
    callback openGraphWindow();

    // File path popup
    file-dialog := FileDialog {
        x: (root.width - 600px) / 2;
        y: (root.height - 460px) / 2;
        is-save: root.file-dialog-is-save;
        current-dir: root.file-browser-dir;
        entries: root.file-browser-entries;
        file-name <=> root.file-browser-file-name;
        navigate(path) => {
            root.dispatch({
                action-type: ActionType.navigate-dir,
                schema-name: "",
                line-index: 0,
                key-data-index: 0,
                new-value: path,
            });
        }
        confirmed(path) => {
            root.dispatch({
                action-type: root.file-dialog-is-save ? ActionType.save-list : ActionType.load-list,
                schema-name: "",
                line-index: 0,
                key-data-index: 0,
                new-value: path,
            });
        }
    }

    // Exit confirmation popup
    confirm-exit-dialog := PopupWindow {
        x: (root.width - 320px) / 2;
        y: (root.height - 140px) / 2;
        width: 320px;
        height: 140px;
        close-policy: PopupClosePolicy.no-auto-close;

        Rectangle {
            background: #f5f5f5;
            border-width: 1px;
            border-color: #999999;
            border-radius: 6px;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "You have unsaved changes. Exit anyway?";
                    wrap: word-wrap;
                    color: black;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => {
                            confirm-exit-dialog.close();
                        }
                    }

                    Button {
                        text: "Exit Anyway";
                        clicked => {
                            confirm-exit-dialog.close();
                            root.dispatch({
                                action-type: ActionType.exit,
                                schema-name: "",
                                line-index: 0,
                                key-data-index: 0,
                                new-value: "",
                            });
                        }
                    }
                }
            }
        }
    }

    // Validation-error popup – shown when save is blocked due to invalid fields
    validation-error-dialog := PopupWindow {
        x: (root.width - 340px) / 2;
        y: (root.height - 140px) / 2;
        width: 340px;
        height: 140px;
        close-policy: PopupClosePolicy.no-auto-close;

        Rectangle {
            background: #f5f5f5;
            border-width: 1px;
            border-color: #999999;
            border-radius: 6px;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Some fields contain invalid values. Please correct them before saving.";
                    wrap: word-wrap;
                    color: black;
                }

                HorizontalBox {
                    alignment: end;

                    Button {
                        text: "OK";
                        clicked => {
                            validation-error-dialog.close();
                            // Re-trigger focus on the first invalid field after popup close.
                            root.validate-epoch += 1;
                        }
                    }
                }
            }
        }
    }

    // About dialog
    about-dialog := PopupWindow {
        x: (root.width - 400px) / 2;
        y: (root.height - 300px) / 2;
        width: 400px;
        height: 300px;

        AboutSlint { }
    }

    changed validation-error-epoch => {
        if (validation-error-epoch > 0) {

            validation-error-dialog.show();
        }
    }

    changed open-save-dialog => {
        if (open-save-dialog) {
            open-save-dialog = false;
            root.dispatch({
                action-type: ActionType.navigate-dir,
                schema-name: "",
                line-index: 0,
                key-data-index: 0,
                new-value: root.file-browser-dir,
            });
            file-dialog.show();
        }
    }

    changed focus-toolbar-epoch => {
        if (focus-toolbar-epoch > 0) {
            add-line-button.focus();
        }
    }

    changed focus-add-list-epoch => {
        if (focus-add-list-epoch > 0) {
            add-list-button.focus();
        }
    }

    // File menu
    MenuBar {
        Menu {
            title: "File";

            MenuItem {
                title: "Save";
                activated => {
                    root.file-dialog-is-save = true;
                    root.dispatch({
                        action-type: ActionType.validate-before-save,
                        schema-name: "",
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
            }

            MenuItem {
                title: "Load";
                activated => {
                    root.file-dialog-is-save = false;
                    root.dispatch({
                        action-type: ActionType.navigate-dir,
                        schema-name: "",
                        line-index: 0,
                        key-data-index: 0,
                        new-value: root.file-browser-dir,
                    });
                    file-dialog.show();
                }
            }

            MenuItem {
                title: "Exit";
                activated => {
                    if (root.is-dirty) {
                        confirm-exit-dialog.show();
                    } else {
                        root.dispatch({
                            action-type: ActionType.exit,
                            schema-name: "",
                            line-index: 0,
                            key-data-index: 0,
                            new-value: "",
                        });
                    }
                }
            }
        }

        Menu {
            title: "Edit";
            MenuItem {
                title: "Add Line";
                activated => {
                    root.dispatch({
                        action-type: ActionType.add-line,
                        schema-name: schema-selector.current-value,
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
                shortcut: @keys(Control + A);
            }

            MenuItem {
                title: "Next List";
                activated => {
                    root.dispatch({
                        action-type: ActionType.cycle-list-next,
                        schema-name: "",
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
                shortcut: @keys(Control + Tab);
            }

            MenuItem {
                title: "Previous List";
                activated => {
                    root.dispatch({
                        action-type: ActionType.cycle-list-prev,
                        schema-name: "",
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
                shortcut: @keys(Control + Shift + Tab);
            }
        }

        Menu {
            title: "View";

            MenuItem {
                title: "3D Graph";
                activated => {
                    root.openGraphWindow();
                }
            }
        }

        Menu {
            title: "Help";

            MenuItem {
                title: "About";
                activated => {
                    about-dialog.show();
                }
            }
        }
    }

    VerticalBox {

        HorizontalLayout {
            alignment: start;
            padding: 4px;
            spacing: 8px;
            add-list-button := Button {
                text: "+ Add List";
                width: 100px;
                height: 30px;
                clicked => {
                    root.dispatch({
                        action-type: ActionType.add-list,
                        schema-name: "",
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
            }
            // Delete-list toolbar (only visible when a non-first tab is active)
            if root.active-list-index > 0: Button {
                text: "Delete List";
                clicked => {
                    root.dispatch({
                        action-type: ActionType.remove-list,
                        schema-name: "",
                        line-index: root.active-list-index,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
            }
        }

        // Tab bar wrapped in a horizontal ScrollView so it scrolls when tabs overflow
        ScrollView {
            height: 42px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                alignment: start;

                for tab-name[ti] in root.list-names: Rectangle {
                    width: 90px;
                    height: 30px;
                    background: ti == root.active-list-index ? #4a90d9 : #d0d0d0;
                    border-radius: 4px;

                    Text {
                        text: tab-name;
                        color: ti == root.active-list-index ? #ffffff : #333333;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-weight: ti == root.active-list-index ? 700 : 400;
                    }

                    TouchArea {
                        clicked => {
                            root.active-list-index = ti;
                            root.dispatch({
                                action-type: ActionType.switch-list,
                                schema-name: "",
                                line-index: ti,
                                key-data-index: 0,
                                new-value: "",
                            });
                        }
                    }
                }
            }
        }

        // Add-line toolbar
        HorizontalBox {
            alignment: start;
            padding: 8px;
            spacing: 8px;

            schema-selector := ComboBox {
                model: root.lines.length == 0 ? root.init-schema-names : root.schema-names;
            }

            add-line-button := Button {
                text: "Add Line";
                clicked => {
                    root.dispatch({
                        action-type: ActionType.add-line,
                        schema-name: schema-selector.current-value,
                        line-index: 0,
                        key-data-index: 0,
                        new-value: "",
                    });
                }
            }
        }

        scroll_view := ScrollView {
            VerticalLayout {
                spacing: 8px;
                padding: 8px;
                alignment: start;

                for line[i] in root.lines: LineCard {
                    line: line;
                    schema-names: root.schema-names;
                    init-schema-names: root.init-schema-names;
                    line-index: i;
                    validate-epoch: root.validate-epoch;
                    focus-line: root.first-invalid-line;
                    focus-key-data: root.first-invalid-key-data;
                    dispatch(action) => {
                        root.dispatch(action);
                    }
                }
            }
        }
    }
}
